# ==========================================================
#  EcommerceHub - environment template
# ==========================================================
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#
#  `.env` is git-ignored and must NEVER be committed.
#  Every value below is read by docker-compose and forwarded
#  to Vault by scripts/vault-init.sh at startup.
# ==========================================================

# ----- Vault -----
# Root token for the dev-mode Vault container. Any non-empty
# string works locally; use a real auth method in production.
VAULT_TOKEN=root

# ----- Database (required) -----
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
# Must match POSTGRES_PASSWORD - this is what gets stored in Vault.
DB_PASSWORD=change-me-strong-password

# ----- Redis -----
# Strong password for the production Redis container
REDIS_PASSWORD=change-me-strong-redis-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ----- Production Docker images -----
# Built by build-push.yml or locally; used by docker-compose.prod.yml
BACKEND_IMAGE=ghcr.io/your-username/ecommerce-backend:latest
FRONTEND_IMAGE=ghcr.io/your-username/ecommerce-frontend:latest

# Public API path used by the Vite build at container build time.
# Leave as /api when nginx is in front of the stack.
VITE_BACK_END_URL=/api

# Full datasource URL for managed Postgres; keep empty to use the compose Postgres.
SPRING_DATASOURCE_URL=

# ----- JWT (required) -----
# Generate a fresh 256-bit base64 secret:
#   openssl rand -base64 32
JWT_SECRET=

# ----- Stripe -----
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# ----- OAuth2: GitHub -----
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- OAuth2: Google -----
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Mail (SMTP) -----
# For Gmail use an App Password, not your account password:
#   https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ----- OpenAI (semantic search & recommendations) -----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ----- Frontend -----
FRONTEND_URL=http://localhost:5173

# ----- Semantic search tuning -----
APP_SEARCH_SEMANTIC_ENABLED=true
APP_SEARCH_SEMANTIC_TOP_K=20
APP_SEARCH_SEMANTIC_SIMILARITY_THRESHOLD=0.50

# ----- Spring AI model wiring -----
SPRING_AI_MODEL_EMBEDDING=openai
SPRING_AI_VECTORSTORE_TYPE=pgvector
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_IMAGE=none
SPRING_AI_MODEL_MODERATION=none
SPRING_AI_MODEL_AUDIO_SPEECH=none
SPRING_AI_MODEL_AUDIO_TRANSCRIPTION=none
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
SPRING_AI_VECTORSTORE_PGVECTOR_ID_TYPE=text
